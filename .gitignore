# =========================================================
# UADB Social — .gitignore racine
# (les branches de dev ont leurs propres .gitignore ; celui-ci
# protège la base et la copie locale)
# =========================================================

# === Secrets / credentials — JAMAIS versionner ============
.env
.env.*
*.env
!*.env.example
**/google-services.json
**/GoogleService-Info.plist
**/service-account*.json
**/firebase-adminsdk*.json
**/*.p8
**/*.p12
**/*.pfx
**/*.keystore
**/*.jks
**/key.properties
**/local.properties

# === IDE / éditeurs =======================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# === OS ===================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# === Logs / détritus ======================================
*.log
*.class
*.pyc

# === Dart / Flutter =======================================
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
pub/

# === Artefacts générés par les builds Flutter (cache local)
**/ephemeral/
**/.gradle/
**/gradle-wrapper.jar
**/gradlew
**/gradlew.bat
**/GeneratedPluginRegistrant.*
**/Generated.xcconfig
**/Flutter-Generated.xcconfig
**/icudtl.dat
**/libflutter_linux_gtk.so